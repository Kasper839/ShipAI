{
  "name": "shipai",
  "version": "1.3.0",
  "description": "Cross-platform desktop server management over SSH.",
  "main": "main/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "package": "electron-builder",
    "check": "node --check main/main.js && node --check main/profileStore.js && node --check main/sshManager.js && node --check preload.js && node --check app/js/renderer-dashboard.js && node --check app/js/renderer-login.js"
  },
  "dependencies": {
    "posthog-node": "^5.61.1",
    "ssh2": "^1.16.0"
  },
  "devDependencies": {
    "electron": "^38.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.kasper839.shipai",
    "productName": "ShipAI",
    "files": [
      "app/**/*",
      "main/**/*",
      "preload.js",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage",
      "category": "Utility"
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ShipAI",
      "multiLanguageInstaller": true,
      "language": 1033,
      "displayLanguageSelector": true
    }
  }
}
